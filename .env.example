# Salin menjadi .env lalu sesuaikan bila perlu.
# Node tidak memuat .env otomatis; ekspor variabel ini lewat shell, Docker, atau platform deploy.

PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
CACHE_DIR=./data/cache

# HTTP cache: 6 jam + stale-while-revalidate 12 jam
CACHE_TTL_SECONDS=21600
CORS_ORIGIN=*

# Lindungi endpoint pemutakhiran
# ADMIN_TOKEN=ganti-dengan-token-rahasia

# Pemutakhiran otomatis
AUTO_REFRESH=true
REFRESH_INTERVAL_MS=43200000
REFRESH_TTL_MS=21600000

# Keamanan & sumber
RATE_LIMIT_PER_MINUTE=0
REFERENCE_TIMEZONE=Asia/Jakarta
FETCH_TIMEOUT_MS=25000
FETCH_DELAY_MS=300

# Notifikasi pemutakhiran (opsional, dipakai oleh GitHub Actions)
# Isi dengan webhook Discord/Slack/Telegram agar diberi tahu bila ada error sumber
# atau tahun baru yang masih berstatus draft. Kosongkan untuk menonaktifkan.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy?wait=true
# ALERT_TELEGRAM_CHAT_ID=123456789
